# Puerto del servidor web local (por defecto 3000)
PORT=3000

# Clave de Groq Cloud API (obligatoria para resolver tareas con IA)
GROQ_API_KEY=

# Contraseña maestra de acceso a la interfaz web (opcional: si se omite, se configura en el primer acceso)
AULES_APP_PASSCODE=

# Credenciales OAuth 2.0 Web para conectar Google Drive (opcional, para sincronización con Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Secreto opcional para cifrado de sesiones en disco y cookies
SESSION_SECRET=
